{
  "name": "xrift-client",
  "version": "0.2.2",
  "private": true,
  "description": "XRift クライアント（非公式テスト）: 本家 app.xrift.net を OpenXR + Vulkan の GPU 内コピー経路で HMD に出す専用ブラウザ",
  "type": "module",
  "scripts": {
    "build": "pnpm --dir client run build",
    "typecheck": "tsc -p client --noEmit",
    "test": "pnpm --dir client test",
    "build:native": "cmake -S native --preset windows-vs && cmake --build native/build/windows --config Release",
    "build:addon": "pwsh -File native/transfer-addon/build.ps1",
    "prestart": "pnpm build",
    "start": "electron client",
    "register": "node client/scripts/register-steamvr.cjs",
    "package": "node client/scripts/package.cjs",
    "electron:install": "install-electron",
    "verify": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^24",
    "@webgpu/types": "^0.1.74",
    "cmake-js": "^8.0.0",
    "electron": "^44.9.0",
    "node-addon-api": "^8.9.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinuX2/XRift-Client.git"
  }
}
