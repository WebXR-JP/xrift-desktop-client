{
  "name": "xrift-client",
  "version": "0.2.0",
  "private": true,
  "description": "XRift クライアント（非公式テスト）: 本家 app.xrift.net を SteamVR で遊ぶ専用ブラウザ",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.js",
    "start": "electron .",
    "register": "node scripts/register-steamvr.js",
    "setup": "npm run build:native && npm run register",
    "browser": "electron .",
    "browser:selftest": "electron . --selftest",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "cmake-js": "^8.0.0",
    "electron": "^44.9.0",
    "node-addon-api": "^8.9.2",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinuX2/XRift-Client.git"
  }
}
