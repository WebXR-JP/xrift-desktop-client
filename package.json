{
  "name": "xrift-client",
  "version": "0.2.2",
  "private": true,
  "description": "XRift クライアント（非公式テスト）: 本家 app.xrift.net を SteamVR で遊ぶ専用ブラウザ",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:mainworld": "node test/mainworld-contract.cjs",
    "verify": "pnpm build && pnpm check:mainworld",
    "electron:install": "install-electron",
    "prebuild:native": "pnpm build",
    "build:native": "node scripts/build-native.js",
    "prestart": "pnpm build",
    "start": "electron .",
    "preregister": "pnpm build",
    "register": "node scripts/register-steamvr.js",
    "setup": "pnpm electron:install && pnpm build:native && pnpm register",
    "prebrowser": "pnpm build",
    "browser": "electron .",
    "prebrowser:selftest": "pnpm build",
    "browser:selftest": "electron . --selftest",
    "prepackage": "pnpm build",
    "package": "node scripts/package.js",
    "app:build": "tsc -p app",
    "app:start": "electron app"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^24",
    "@webgpu/types": "^0.1.74",
    "cmake-js": "^8.0.0",
    "electron": "^44.9.0",
    "node-addon-api": "^8.9.2",
    "three": "^0.186.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.15",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.29.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KinuX2/XRift-Client.git"
  }
}
