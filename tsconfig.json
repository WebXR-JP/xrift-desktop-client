{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "@webgpu/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "newLine": "crlf",
    "forceConsistentCasingInFileNames": true,
    "allowJs": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
